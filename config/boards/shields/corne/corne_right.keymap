#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&kscan0 {
    row-gpios
        = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
/ {

    combos {
        compatible = "zmk,combos";

        purewrite {
            bindings = <&tog 3>;
            key-positions = <37 36 38>;
            layers = <3 0>;
        };

        normal {
            timeout-ms = <50>;
            key-positions = <0 12 24>;
            bindings = <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
   &kp Z         &kp F      &kp U           &kp SINGLE_QUOTE  &kp BACKSLASH  &kp ESCAPE
    &kp P         &kp N      &kp E           &kp A             &kp O          &kp SEMICOLON
   &kp B         &kp H      &kp COMMA       &kp DOT           &kp X          &kp SLASH
   &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer1 {
            bindings = <
         &kp DELETE    &kp N7     &kp N8          &kp N9  &kp BACKSLASH  &kp ESCAPE
    &kp MINUS     &kp N4     &kp N5          &kp N6  &kp EQUAL      &kp SEMICOLON
            &kp NUMBER_0  &kp N1     &kp N2          &kp N3  &kp GRAVE      &kp SLASH
                                                              &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer2 {
            bindings = <
   &none          &kp F7     &kp F8          &kp F9  &kp F10  &kp ESCAPE
       &kp C_BRI_UP   &kp F4     &kp F5          &kp F6  &kp F11  &none
  &kp F1     &kp F2          &kp F3  &kp F12  &none
                                          &kp ENTER      &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer_3 {
            bindings = <
    &kp Z         &kp F      &kp U           &kp SINGLE_QUOTE  &kp BACKSLASH  &none
   &kp P         &kp N      &kp E           &kp A             &kp O          &kp SEMICOLON
    &kp B         &kp H      &kp COMMA       &kp DOT           &kp X          &kp SLASH
   &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer_4 {
            bindings = <
         &kp DELETE    &kp N7     &kp N8          &kp N9  &kp BACKSLASH  &none
   &kp MINUS     &kp N4     &kp N5          &kp N6  &kp EQUAL      &kp SEMICOLON
              &kp NUMBER_0  &kp N1     &kp N2          &kp N3  &kp GRAVE      &kp SLASH
                                                     &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };
    };
};
