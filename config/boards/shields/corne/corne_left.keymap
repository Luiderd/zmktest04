#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        purewrite {
            bindings = <&tog 3>;
            key-positions = <37 36 38>;
            layers = <3 0>;
        };

        normal {
            timeout-ms = <50>;
            key-positions = <0 12 24>;
            bindings = <&to 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp LEFT_GUI  &kp Y  &kp C  &kp L             &kp M          &kp K    &kp Z         &kp F      &kp U           &kp SINGLE_QUOTE  &kp BACKSLASH  &kp ESCAPE
&kp TAB       &kp I  &kp S  &kp R             &kp T          &kp G    &kp P         &kp N      &kp E           &kp A             &kp O          &kp SEMICOLON
&kp LEFT_ALT  &kp Q  &kp V  &kp W             &kp D          &kp J    &kp B         &kp H      &kp COMMA       &kp DOT           &kp X          &kp SLASH
                            &kp LEFT_CONTROL  &kp BACKSPACE  &mo 1    &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer1 {
            bindings = <
&kp LEFT_GUI  &kp HOME          &kp C_VOLUME_DOWN  &kp UP            &kp C_VOLUME_UP  &kp C_MUTE           &kp DELETE    &kp N7     &kp N8          &kp N9  &kp BACKSLASH  &kp ESCAPE
&kp TAB       &kp LEFT_BRACKET  &kp LEFT           &kp DOWN          &kp RIGHT        &kp RIGHT_BRACKET    &kp MINUS     &kp N4     &kp N5          &kp N6  &kp EQUAL      &kp SEMICOLON
&kp LEFT_ALT  &kp C_AC_SEARCH   &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &to 2               &kp NUMBER_0  &kp N1     &kp N2          &kp N3  &kp GRAVE      &kp SLASH
                                                   &kp LEFT_CONTROL  &kp BACKSPACE    &none                &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer2 {
            bindings = <
&bt BT_SEL 0  &bt BT_DISC 0  &none         &none             &none          &bt BT_CLR    &none          &kp F7     &kp F8          &kp F9  &kp F10  &kp ESCAPE
&bt BT_SEL 1  &bt BT_DISC 1  &bt BT_PRV    &none             &bt BT_NXT     &none         &kp C_BRI_UP   &kp F4     &kp F5          &kp F6  &kp F11  &none
&bt BT_SEL 2  &bt BT_DISC 2  &none  &none     &none          &none        &kp C_BRI_DEC  &kp F1     &kp F2          &kp F3  &kp F12  &none
                                           &kp LEFT_CONTROL  &kp BACKSPACE  &to 0         &kp ENTER      &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer_3 {
            bindings = <
&none  &kp Y  &kp C  &kp L  &kp M          &kp K    &kp Z         &kp F      &kp U           &kp SINGLE_QUOTE  &kp BACKSLASH  &none
&none  &kp I  &kp S  &kp R  &kp T          &kp G    &kp P         &kp N      &kp E           &kp A             &kp O          &kp SEMICOLON
&none  &kp Q  &kp V  &kp W  &kp D          &kp J    &kp B         &kp H      &kp COMMA       &kp DOT           &kp X          &kp SLASH
                     &none  &kp BACKSPACE  &mo 4    &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };

        layer_4 {
            bindings = <
&none  &kp HOME          &kp C_VOLUME_DOWN  &kp UP            &kp C_VOLUME_UP  &kp C_MUTE           &kp DELETE    &kp N7     &kp N8          &kp N9  &kp BACKSLASH  &none
&none  &kp LEFT_BRACKET  &kp LEFT           &kp DOWN          &kp RIGHT        &kp RIGHT_BRACKET    &kp MINUS     &kp N4     &kp N5          &kp N6  &kp EQUAL      &kp SEMICOLON
&none  &none             &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &none                &kp NUMBER_0  &kp N1     &kp N2          &kp N3  &kp GRAVE      &kp SLASH
                                            &none             &kp BACKSPACE    &none                &kp KP_ENTER  &kp SPACE  &kp LEFT_SHIFT
            >;
        };
    };
};/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};
